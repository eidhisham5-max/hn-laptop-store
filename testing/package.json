{
  "name": "hn-laptop-store-testing",
  "version": "1.0.0",
  "description": "Testing suite for H.N Laptop Store",
  "main": "automated_test_script.js",
  "scripts": {
    "test": "node automated_test_script.js",
    "test:mobile": "node automated_test_script.js --mobile",
    "test:tablet": "node automated_test_script.js --tablet",
    "test:desktop": "node automated_test_script.js --desktop",
    "test:rtl": "node automated_test_script.js --rtl",
    "test:performance": "node automated_test_script.js --performance",
    "test:accessibility": "node automated_test_script.js --accessibility",
    "test:all": "npm run test && npm run test:mobile && npm run test:tablet && npm run test:desktop"
  },
  "dependencies": {
    "puppeteer": "^21.0.0",
    "jest": "^29.0.0",
    "playwright": "^1.40.0",
    "lighthouse": "^11.0.0",
    "axe-core": "^4.8.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "testing",
    "e2e",
    "puppeteer",
    "accessibility",
    "performance",
    "rtl",
    "ltr"
  ],
  "author": "H.N Laptop Store Team",
  "license": "MIT"
}
